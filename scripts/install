#!/usr/bin/env bash
set -euo pipefail

if ! command -v uv >/dev/null 2>&1; then
    printf '%s\n' \
        'uv is required. See https://docs.astral.sh/uv/getting-started/installation/.' >&2
    exit 1
fi

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
uv venv --allow-existing --python 3.12 .venv
exec uv pip sync --python .venv requirements.txt
